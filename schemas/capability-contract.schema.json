{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:capability-contract:v1alpha1",
  "title": "CapabilityContract",
  "description": "CapabilityContract (spec sections 8 and 15). Fields listed in spec Appendix C.4 remain experimental: accepted, with warnings only from their checks.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "CapabilityContract"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "effect": {},
        "outcomeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "requiredInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capacity": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "maturity": {
          "type": "string"
        },
        "validityScope": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
