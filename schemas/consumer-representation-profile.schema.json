{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:consumer-representation-profile:v1alpha1",
  "title": "ConsumerRepresentationProfile",
  "description": "ConsumerRepresentationProfile (spec section 18).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "ConsumerRepresentationProfile"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "worldViewRef": {
          "type": "string"
        },
        "representation": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string"
            },
            "freshness": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "provenance": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "human": {
          "type": "object",
          "properties": {
            "artifactContractRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "presentation": {
              "type": "string"
            },
            "locale": {
              "type": "string"
            },
            "decisionRights": {
              "type": "string"
            },
            "notification": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "agent": {
          "type": "object",
          "properties": {
            "toolScope": {
              "type": "object",
              "properties": {
                "capabilityRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "memoryScope": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "feasibleActions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contextBudget": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "adapterRef": {
              "type": "string"
            },
            "modalities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "temporalWindow": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "system": {
          "type": "object",
          "properties": {
            "interfaceRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deliveryMode": {
              "type": "string"
            },
            "serviceLevel": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "externalRef": {
      "description": "Reference to an artifact outside the package (spec section 5.1).",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "huggingface",
                "oci",
                "git",
                "https",
                "s3",
                "gcs",
                "doi"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}:.+$"
            }
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "bound",
            "unbound"
          ],
          "default": "bound"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  }
}
