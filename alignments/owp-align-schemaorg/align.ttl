@prefix owp: <https://w3id.org/owp/ns#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<https://w3id.org/owp/align/schemaorg> a owl:Ontology ;
  owl:imports <https://w3id.org/owp/ns> ;
  rdfs:comment "Informative SKOS matches from OWP to schema.org. Annotations only: no axioms."@en .
skos:broadMatch a owl:AnnotationProperty .
skos:closeMatch a owl:AnnotationProperty .
skos:relatedMatch a owl:AnnotationProperty .
owp:Package skos:broadMatch schema:CreativeWork .
owp:WorldPackage skos:relatedMatch schema:Dataset .
owp:Observation skos:relatedMatch schema:Observation .
owp:observedAt skos:closeMatch schema:observationDate .
owp:Compilation skos:relatedMatch schema:Action .
owp:packageId skos:relatedMatch schema:identifier .
owp:dependsOn skos:relatedMatch schema:isBasedOn .
