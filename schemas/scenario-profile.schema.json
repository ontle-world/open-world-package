{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:scenario-profile:v1alpha1",
  "title": "ScenarioProfile",
  "description": "ScenarioProfile (spec section 8). Fields listed in spec Appendix C.4 are experimental: accepted, with warnings only from their checks.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "ScenarioProfile"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "standardBindings": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "baselineStateRef": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intervention": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "engine": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "timeHorizon": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "confidence": {},
        "expectedOutcome": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
