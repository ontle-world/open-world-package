{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:manifest:v1alpha1",
  "title": "Open World Package Manifest",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "enum": [
        "WorldPackage",
        "WorldModelPackage",
        "OntologyPackage"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "$ref": "#/$defs/assetKind"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "$ref": "#/$defs/externalRef"
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "oneOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "PackageExample"
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "description": "External assets (ref) and PackageExample files (path). Other local assets are found by their own apiVersion and kind (spec section 5)."
        },
        "world": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            },
            "defaultView": {
              "type": "string",
              "minLength": 1
            },
            "defaultStateCompiler": {
              "type": "string",
              "minLength": 1
            },
            "boundary": {
              "type": "object",
              "properties": {
                "included": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "semanticBinding": {
              "type": "string",
              "minLength": 1,
              "description": "Path of the local SemanticBinding asset (spec section 14)."
            }
          },
          "additionalProperties": false
        },
        "worldModel": {
          "type": "object",
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "semanticGrounding": {
              "type": "object",
              "required": [
                "worldRef",
                "compatibleWorldViews",
                "compatibleStateCompilers"
              ],
              "properties": {
                "worldRef": {
                  "type": "string",
                  "minLength": 1
                },
                "compatibleWorldViews": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "compatibleStateCompilers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "inputs": {
              "type": "object",
              "required": [
                "contract"
              ],
              "properties": {
                "contract": {
                  "const": "EffectiveWorldState"
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "representation": {
              "type": "object",
              "required": [
                "adapterRef"
              ],
              "properties": {
                "adapterRef": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "string"
                },
                "internal": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "description": {
              "type": "string"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modalities": {
              "type": "object",
              "properties": {
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "additionalProperties": false
            },
            "temporal": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "validity": {
              "type": "object",
              "description": "Open container: keys are not checked."
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false,
          "required": [
            "roles",
            "semanticGrounding",
            "inputs",
            "representation"
          ]
        },
        "conformance": {
          "type": "object",
          "description": "WorldPackage or OntologyPackage. Profiles are cumulative.",
          "properties": {
            "profile": {
              "enum": [
                "descriptive",
                "viewable",
                "stateful",
                "model-ready",
                "action-ready",
                "vocabulary",
                "schema",
                "constrained",
                "mapped"
              ]
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "ontology": {
          "type": "object",
          "description": "OntologyPackage only (spec section 3.1).",
          "properties": {
            "description": {
              "type": "string"
            },
            "iri": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
            },
            "prefixes": {
              "type": "object",
              "description": "Prefix name -> namespace IRI.",
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "entrypoints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "format",
                  "role"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "enum": [
                      "owp-yaml",
                      "turtle",
                      "jsonld",
                      "owl-xml",
                      "ntriples",
                      "linkml",
                      "sssom-tsv"
                    ]
                  },
                  "role": {
                    "enum": [
                      "schema",
                      "shapes",
                      "mappings",
                      "labels"
                    ]
                  },
                  "extensions": {
                    "$ref": "#/$defs/extensions"
                  }
                },
                "additionalProperties": false
              }
            },
            "termIndex": {
              "type": "string",
              "minLength": 1
            },
            "externalImports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "iri",
                  "ref"
                ],
                "properties": {
                  "iri": {
                    "type": "string"
                  },
                  "ref": {
                    "$ref": "#/$defs/externalRef"
                  },
                  "extensions": {
                    "$ref": "#/$defs/extensions"
                  }
                },
                "additionalProperties": false
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "extensionDefinition": {
          "type": "object",
          "description": "Present when this package defines an extension (spec section 13).",
          "properties": {
            "description": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              }
            },
            "schemas": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validity": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "WorldPackage"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "world"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "spec": {
                  "properties": {
                    "conformance": {
                      "properties": {
                        "profile": {
                          "enum": [
                            "viewable",
                            "stateful",
                            "model-ready",
                            "action-ready"
                          ]
                        }
                      },
                      "required": [
                        "profile"
                      ]
                    }
                  },
                  "required": [
                    "conformance"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "spec": {
                  "required": [
                    "assets"
                  ],
                  "properties": {
                    "world": {
                      "required": [
                        "defaultView"
                      ]
                    },
                    "assets": {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "WorldViewProfile"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "minContains": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "spec": {
                  "properties": {
                    "conformance": {
                      "properties": {
                        "profile": {
                          "enum": [
                            "stateful",
                            "model-ready",
                            "action-ready"
                          ]
                        }
                      },
                      "required": [
                        "profile"
                      ]
                    }
                  },
                  "required": [
                    "conformance"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "spec": {
                  "properties": {
                    "world": {
                      "required": [
                        "defaultStateCompiler"
                      ]
                    },
                    "assets": {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "StateCompilerProfile"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "minContains": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "spec": {
                  "properties": {
                    "conformance": {
                      "properties": {
                        "profile": {
                          "enum": [
                            "action-ready"
                          ]
                        }
                      },
                      "required": [
                        "profile"
                      ]
                    }
                  },
                  "required": [
                    "conformance"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "spec": {
                  "properties": {
                    "assets": {
                      "allOf": [
                        {
                          "contains": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "ActionBindingProfile"
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          },
                          "minContains": 1
                        },
                        {
                          "contains": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "CommitContract"
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          },
                          "minContains": 1
                        },
                        {
                          "contains": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "const": "EffectVerificationProfile"
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          },
                          "minContains": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "WorldModelPackage"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "spec": {
            "required": [
              "worldModel",
              "assets"
            ],
            "properties": {
              "worldModel": {
                "required": [
                  "roles",
                  "semanticGrounding"
                ]
              },
              "assets": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "RepresentationAdapterProfile"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "assetKind": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        {
          "pattern": "^[a-z][a-z0-9-]{0,62}:[A-Z][A-Za-z0-9]*$"
        }
      ],
      "description": "A vocabulary kind, or an extension kind <extension>:<Kind> (spec section 13)."
    },
    "packageRef": {
      "type": "string",
      "pattern": "^[^/@#\\s]+/[^/@#\\s]+@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/packageRef"
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/packageRef"
            },
            "source": {
              "type": "string"
            },
            "as": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "not": {
                "enum": [
                  "owp",
                  "openworld"
                ]
              },
              "description": "Declares this dependency as an extension and names it (spec section 13)."
            },
            "mustUnderstand": {
              "type": "boolean",
              "description": "Runtimes that do not implement the extension must not run the package."
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "dependentRequired": {
            "mustUnderstand": [
              "as"
            ]
          },
          "additionalProperties": false
        }
      ]
    },
    "externalRef": {
      "description": "Reference to an artifact outside the package (spec section 5.1).",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "huggingface",
                "oci",
                "git",
                "https",
                "s3",
                "gcs",
                "doi"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}:.+$"
            }
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "bound",
            "unbound"
          ],
          "default": "bound"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  }
}
