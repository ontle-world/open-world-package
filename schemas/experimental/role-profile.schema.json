{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:experimental:RoleProfile:v1alpha1",
  "title": "RoleProfile (experimental)",
  "description": "Experimental asset kind (spec Appendix C). Violations are warnings, not errors.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "RoleProfile"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string"
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "additionalProperties": false
          }
        },
        "authorities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decisions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string"
              },
              "ceiling": {
                "type": "object",
                "description": "Open container: keys are not checked."
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "additionalProperties": false
          }
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accountabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "externalRef": {
      "description": "Reference to an artifact outside the package (spec section 5.1).",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "huggingface",
                "oci",
                "git",
                "https",
                "s3",
                "gcs",
                "doi"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}:.+$"
            }
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "bound",
            "unbound"
          ],
          "default": "bound"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  }
}
