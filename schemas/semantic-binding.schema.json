{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:semantic-binding:v1alpha1",
  "title": "SemanticBinding",
  "description": "Binds World names, EWS fields, observation types, and actions to ontology terms (spec section 14).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "SemanticBinding"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "object",
          "description": "World name -> class CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "fields": {
          "type": "object",
          "description": "EWS field -> {class, path}.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
                }
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "additionalProperties": false
          }
        },
        "observationTypes": {
          "type": "object",
          "description": "Observation type -> class CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "actions": {
          "type": "object",
          "description": "Action name -> CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
