{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:ontology-term-index:v1alpha1",
  "title": "OntologyTermIndex",
  "description": "Terms an OntologyPackage defines (spec section 3.1). Generated by `ontle ontology index` for RDF and LinkML schemas.",
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "OntologyTermIndex"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "terms"
      ],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "iri",
              "type"
            ],
            "properties": {
              "iri": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "class",
                  "property",
                  "individual",
                  "datatype",
                  "concept"
                ]
              },
              "label": {
                "type": "string"
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              },
              "status": {
                "enum": [
                  "candidate",
                  "stable",
                  "deprecated"
                ],
                "description": "Experimental (Appendix C.1): the term's lifecycle status; absent means stable."
              },
              "replacedBy": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ],
                "description": "Experimental (Appendix C.1): the absolute IRIs of the terms that replace a deprecated term."
              }
            },
            "additionalProperties": false
          }
        },
        "removed": {
          "type": "array",
          "description": "Experimental (Appendix C.1): terms the ontology no longer defines (tombstones), with what replaces them.",
          "items": {
            "type": "object",
            "properties": {
              "iri": {
                "type": "string"
              },
              "replacedBy": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ],
                "description": "Experimental (Appendix C.1): the absolute IRIs of the terms that replace the removed term."
              },
              "removedIn": {
                "type": "string",
                "description": "Experimental (Appendix C.1): the version of the ontology that removed the term."
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
