{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:artifact-contract:v1alpha1",
  "title": "ArtifactContract",
  "description": "ArtifactContract (spec section 18).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "ArtifactContract"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "representation": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "purposeRef": {
          "type": "string"
        },
        "audienceRef": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structure": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "serialization": {
          "type": "object",
          "properties": {
            "formats": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "properties": {
            "destinations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "governance": {
          "type": "object",
          "properties": {
            "approvalRequired": {
              "type": "boolean"
            },
            "policyRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "schemaRef": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedOperations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "supersedes": {
          "type": "string"
        },
        "validationRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluationRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "externalRef": {
      "description": "Reference to an artifact outside the package (spec section 5.1).",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "huggingface",
                "oci",
                "git",
                "https",
                "s3",
                "gcs",
                "doi"
              ]
            },
            {
              "pattern": "^[a-z][a-z0-9-]{0,62}:.+$"
            }
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "bound",
            "unbound"
          ],
          "default": "bound"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  }
}
