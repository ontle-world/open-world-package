{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:semantic-binding:v1alpha1",
  "title": "SemanticBinding",
  "description": "Binds World names, EWS fields, observation types, and actions to ontology terms (spec section 14).",
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "SemanticBinding"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "object",
          "description": "World name -> class CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "fields": {
          "type": "object",
          "description": "EWS field -> {class, path}.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
                }
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              },
              "unit": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$",
                "description": "Unit of the field's values as a term of a dependency ontology, such as a QUDT unit (spec section 14). The State Compiler declares the UCUM code (section 12.5)."
              },
              "values": {
                "type": "object",
                "description": "Coded values tied to concepts (spec section 14): map wins over base.",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
                  },
                  "base": {
                    "type": "string",
                    "description": "Absolute IRI prefix; an IRI-safe code is appended."
                  },
                  "map": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
                    },
                    "minProperties": 1
                  }
                },
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "base"
                    ]
                  },
                  {
                    "required": [
                      "map"
                    ]
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "observationTypes": {
          "type": "object",
          "description": "Observation type -> class CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "actions": {
          "type": "object",
          "description": "Action name -> CURIE.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[^\\s/][^\\s]*$"
          }
        },
        "subjects": {
          "type": "object",
          "description": "Observation type -> how its subjects become IRIs (spec sections 12.3, 14): {base: <IRI prefix>} or {iri: true}.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string"
              },
              "iri": {
                "const": true
              }
            },
            "additionalProperties": false
          }
        },
        "semanticIds": {
          "type": "object",
          "description": "External dictionary identifiers (IRDIs or absolute IRIs) per bound name, by section (spec section 14).",
          "propertyNames": {
            "enum": [
              "terms",
              "fields",
              "observationTypes",
              "actions"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
