{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owp:schema:evaluation-profile:v1alpha1",
  "title": "EvaluationProfile",
  "description": "EvaluationProfile (spec sections 8 and 15).",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "openworld/v1alpha1"
    },
    "kind": {
      "const": "EvaluationProfile"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "supersedes": {
          "type": "string"
        },
        "changedBecause": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {},
        "tasks": {},
        "checks": {},
        "assessmentKind": {
          "type": "string"
        },
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "additionalProperties": false
        },
        "objective": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string"
              },
              "rubric": {},
              "threshold": {},
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            },
            "additionalProperties": false
          }
        },
        "verifierRef": {
          "type": "string"
        },
        "evaluatorRef": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validityScope": {
          "type": "object",
          "description": "Open container: keys are not checked."
        },
        "resultSchemaRef": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "$defs": {
    "extensions": {
      "description": "Extension data (spec section 13): declared extension name -> mapping.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
